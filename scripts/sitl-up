#!/usr/bin/env bash
# sitl-up: start the pinned ArduPilot Copter SITL binary directly (no MAVProxy).
# Run it inside the landing-lab container. See docs/sitl-up.md.
set -euo pipefail

# Pins (D-038 M1-P2). Override only for tests.
PIN_COMMIT="${SITL_SRC_COMMIT:-fb773567896014da007bca58358704d4a0d8516f}"
PIN_SHA256="${SITL_BIN_SHA256:-4caa3e509113eb1622383fa55f11a0078f2526042481095c056a22d04c1b9b95}"

SRC="${SITL_SRC_DIR:-$HOME/src/ardupilot}"
WORKDIR="${SITL_WORKDIR:-$HOME/sitl-run}"
HOME_LOC="-35.363261,149.165230,584,353" # CMAC, from Tools/autotest/locations.txt
SERIAL0="tcp:5760"                       # MAVProxy or a ground station connects here
UDP_OUT=""
WIPE=1
PRINT=0

usage() {
  cat <<USAGE
Usage: scripts/sitl-up [options]
  --print            Print the command and exit. Do not start SITL.
  --udp-out HOST:PORT  Also send MAVLink over UDP from SERIAL1. HOST must be 127.0.0.1.
  --no-wipe          Keep the parameters in the work directory.
  --workdir DIR      Work directory (default: \$HOME/sitl-run).
  -h, --help         Show this text.
Environment: SITL_SRC_DIR (default \$HOME/src/ardupilot), SITL_WORKDIR.
The script checks the source commit and the binary SHA-256 before it starts.
USAGE
}

die() { echo "sitl-up: $*" >&2; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --print) PRINT=1 ;;
    --no-wipe) WIPE=0 ;;
    --udp-out) [ $# -ge 2 ] || die "--udp-out needs HOST:PORT"; UDP_OUT="$2"; shift ;;
    --workdir) [ $# -ge 2 ] || die "--workdir needs DIR"; WORKDIR="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
  shift
done

if [ -n "$UDP_OUT" ]; then
  [[ "$UDP_OUT" =~ ^127\.0\.0\.1:([0-9]{1,5})$ ]] || die "--udp-out must be 127.0.0.1:PORT"
  port="${BASH_REMATCH[1]}"
  [ $((10#$port)) -ge 1024 ] && [ $((10#$port)) -le 65535 ] || die "--udp-out port must be 1024..65535"
fi
[ "$(id -u)" -ne 0 ] || die "do not run as root"

BIN="$SRC/build/sitl/bin/arducopter"
AUTOTEST="$SRC/Tools/autotest"
DEFAULTS="$AUTOTEST/default_params/copter.parm"

[ -x "$BIN" ] || die "binary not found: $BIN"
[ -f "$DEFAULTS" ] || die "defaults file not found: $DEFAULTS"
actual_commit="$(git -C "$SRC" rev-parse HEAD 2>/dev/null)" || die "cannot read source commit in $SRC"
[ "$actual_commit" = "$PIN_COMMIT" ] || die "source commit $actual_commit differs from pin $PIN_COMMIT"
actual_sha="$(sha256sum "$BIN" | cut -d' ' -f1)"
[ "$actual_sha" = "$PIN_SHA256" ] || die "binary sha256 $actual_sha differs from pin $PIN_SHA256"

cmd=("$BIN" --model + --speedup 1 --sysid 1 --home "$HOME_LOC"
     --defaults "$DEFAULTS" --autotest-dir "$AUTOTEST" --serial0 "$SERIAL0")
[ -z "$UDP_OUT" ] || cmd+=(--serial1 "udpclient:$UDP_OUT")
[ "$WIPE" -eq 0 ] || cmd+=(--wipe)

if [ "$PRINT" -eq 1 ]; then
  echo "cd $WORKDIR"
  printf '%q ' "${cmd[@]}"; echo
  exit 0
fi

if pgrep -x arducopter >/dev/null 2>&1; then die "an arducopter process already runs"; fi
mkdir -p "$WORKDIR"
cd "$WORKDIR"
exec "${cmd[@]}"
